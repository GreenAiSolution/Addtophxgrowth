# ============================================================================
# Add To PHX — environment variables
# Copy to .env and fill in. Never commit real secrets.
# ============================================================================

# --- Core ---
# Public base URL of the app. Used for Stripe redirects, notification links,
# the sitemap, robots.txt and Open Graph card URLs.
# SET THIS IN PRODUCTION. If it is missing, your sitemap will advertise
# localhost URLs to Google and shared links will render blank cards.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL: Vercel Postgres or Neon) ---
# Neon example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/addtophx

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
# Trust the host in local/dev/preview
AUTH_TRUST_HOST=true

# Google OAuth (optional — enables "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic link SMTP (optional — enables passwordless email sign-in)
# e.g. Resend SMTP, Postmark, Mailtrap for local testing
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=no-reply@phxgrowth.com

# --- Anthropic (server-side only; NEVER expose to the client) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs — generate with `pnpm stripe:setup`, then paste here:
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_COMMAND=
# One-time build fees (non-recurring prices; also printed by `pnpm stripe:setup`)
STRIPE_PRICE_LAUNCH_SETUP=
STRIPE_PRICE_SCALE_SETUP=
STRIPE_PRICE_COMMAND_SETUP=
STRIPE_PRICE_MONITOR=
STRIPE_PRICE_OPERATE=
STRIPE_PRICE_DOMINATE=
# Ad-ops one-time build fees (account audit, tracking repair, baseline)
STRIPE_PRICE_MONITOR_SETUP=
STRIPE_PRICE_OPERATE_SETUP=
STRIPE_PRICE_DOMINATE_SETUP=

# --- Integrations (outbound webhooks) ---
# Zapier Catch Hook → HubSpot contact creation
ZAPIER_ONBOARD_HOOK_URL=
ZAPIER_LEAD_HOOK_URL=

# --- The switchboard (Patch) ---
# The telephony account's signing secret. Set it and every inbound webhook must
# carry a valid signature; leave it blank and a deploy with no carrier can still
# answer a test call. The per-tenant token in the URL decides WHOSE call it is;
# this decides whether it is a real call at all.
VOICE_AUTH_TOKEN=
# Where to POST an outgoing SMS or a callback request. A URL rather than a
# vendor SDK on purpose — no carrier has been signed, and the recovery text
# should not be blocked on a procurement decision. With neither this nor a
# Zapier hook set, nothing is sent and the reason is recorded on the call.
VOICE_SMS_URL=
VOICE_SMS_TOKEN=

# --- Unattended runs: the night shift (agents) and the Spend Watch (ad-ops) ---
# Shared secret for /api/cron/night-shift, which drives both. Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET`. Generate with: openssl rand -base64 32
# REQUIRED for the night shift: with no value set the cron route refuses every
# request rather than leaving an endpoint open that spends your Anthropic budget.
CRON_SECRET=

# --- Notifications ---
# Where agency-bound mail goes: reservations, new requests, client replies,
# critical Spend Watch alerts, contact-form enquiries. Optional — it falls back
# to SEED_ADMIN_EMAIL and then to BRAND.notifyEmail in src/lib/brand.ts, so a
# deploy with no config at all still addresses a real inbox.
AGENCY_NOTIFY_EMAIL=

# THE ONLY THING NEEDED TO ACTUALLY DELIVER EMAIL.
# Resend is the one-secret path: sign up, create an API key, paste it here.
# Their onboarding sender works before any domain is verified, so this alone
# makes email work. Set EMAIL_FROM too once phxgrowth.com is verified.
# Without this (or EMAIL_SERVER_HOST above) notifications are logged and sent
# to the Zapier hook only — nothing throws and no user flow ever fails.
RESEND_API_KEY=

# --- Seed ---
SEED_ADMIN_EMAIL=admin@phxgrowth.com
