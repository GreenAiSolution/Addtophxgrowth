// PHX Growth Plus — data model.
// Feature gating uses Subscription rows as the source of truth (kept in sync by
// the Stripe webhook handler). Every client-owned row carries clientId for
// multi-tenant scoping (see src/lib/tenancy.ts).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector, declared so `db push` installs it rather than failing on a
  // column type the database has never heard of.
  extensions = [vector]
}

enum Role {
  CLIENT
  ADMIN
}

enum ProductLineKey {
  AI_AGENTS
  AD_OPS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  DELIVERED
}

enum RequestKind {
  NEW_CREATIVE
  CAMPAIGN_CHANGE
  STRATEGY_QUESTION
  OTHER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

/// READY = live now; SCHEDULED = human build work; IN_PROGRESS = being delivered.
enum ProvisionStatus {
  READY
  SCHEDULED
  IN_PROGRESS
}

/// Lifecycle of an inbound lead, from webhook to closed deal.
enum LeadStatus {
  NEW
  SCORED
  WORKING
  WON
  LOST
}

/// How often the night shift produces a brief for a client. Tier-gated.
enum BriefCadence {
  DAILY
  WEEKLY
}

enum BriefStatus {
  PENDING
  COMPLETE
  FAILED
}

enum DealOutcomeKind {
  WON
  LOST
}

/// What the Spend Watch found. One value per check in lib/spend-watch.ts.
enum AdAlertKind {
  PACING_OVER
  PACING_UNDER
  CPL_DRIFT
  DELIVERY_GAP
  CREATIVE_FATIGUE
  CPA_BREACH
  ROAS_DECLINE
  ANOMALY
}

enum AdAlertSeverity {
  CRITICAL
  WARNING
  INFO
}

/// How an automation's proposal is held before it can act.
enum GateHold {
  /// Never fires without a named human releasing it. Anything that moves money.
  MANUAL
  /// Visible before it goes; auto-releases when the review window closes.
  TIMED
}

enum GateState {
  HELD
  RELEASED
  EXECUTED
  /// A human pulled it out of the queue.
  WITHDRAWN
  /// Nobody released it in time. Never fires.
  EXPIRED
  FAILED
}

enum AdAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// Whether an employee a client has hired is actually working.
enum EmploymentState {
  /// Runs, but every duty escalates instead of proposing. The supervised week.
  TRIAL
  ACTIVE
  /// Stopped by a person. Nothing runs; nothing is deleted.
  SUSPENDED
}

enum EmployeeRunStatus {
  RUNNING
  COMPLETE
  /// Finished, and handed the outcome to a person rather than the gate.
  ESCALATED
  FAILED
  /// Not due, not hired, or the tier does not include it.
  SKIPPED
}

enum EscalationState {
  OPEN
  ANSWERED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) core models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CLIENT)

  accounts Account[]
  sessions Session[]

  // A CLIENT user owns exactly one ClientProfile (their tenant).
  clientProfile ClientProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Tenant + subscription domain
// ---------------------------------------------------------------------------

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName String
  industry     String?
  website      String?
  adPlatforms  String[]  @default([])
  goals        String?
  voiceTone    String? // saved brand voice used by agents
  onboardedAt  DateTime?

  /// Industry pack (see lib/verticals.ts). Pre-tunes the rubric, escalation
  /// matrix, voice profile and playbook prompts at provisioning time.
  verticalKey String?

  // --- Intake. Captured at onboarding; these are the answers the build phase
  // --- would otherwise extract on a call, repeated for every single client.
  serviceArea        String?
  offerSummary       String?   @db.Text
  priceRange         String?
  differentiator     String?   @db.Text
  proofPoints        String?   @db.Text
  /// Targets, in cents. Copied onto the client's ad accounts so the Spend Watch
  /// checks that depend on them stop being skipped.
  monthlyBudgetCents Int?
  targetCplCents     Int?
  targetCpaCents     Int?
  targetRoas         Float?
  crmPlatform        String?
  leadDestination    String?
  approverName       String?
  approverEmail      String?
  wordsWeUse         String?
  wordsWeAvoid       String?
  /// Anything the structured columns don't cover, kept verbatim.
  intakeAnswers      Json?
  /// Set when the client finishes the intake, as distinct from onboardedAt
  /// which only means they saw the first screen.
  intakeCompletedAt  DateTime?

  /// Secret for this tenant's public lead-intake endpoint. Rotatable.
  intakeToken String? @unique

  /// Night shift: the unattended run that produces the morning brief.
  nightShiftEnabled   Boolean   @default(true)
  /// UTC hour (0-23) the brief should be waiting by. Default 13:00 UTC = 6am Phoenix.
  briefHourUtc        Int       @default(13)
  /// Last completed Spend Watch sweep. Gates the hourly cron to one sweep a day
  /// even when a sweep finds nothing and so writes no alert rows.
  spendWatchLastRunAt DateTime?

  stripeCustomerId String? @unique

  subscriptions    Subscription[]
  conversations    AgentConversation[]
  usageRecords     UsageRecord[]
  adAccounts       AdAccount[]
  requests         Request[]
  webhookConfigs   WebhookConfig[]
  agentOverrides   AgentPromptOverride[]
  provisionedItems ProvisionedItem[]
  leads            Lead[]
  briefRuns        BriefRun[]
  dealOutcomes     DealOutcome[]
  memoryEntries    MemoryEntry[]
  adAlerts         AdAlert[]
  entitlements     ClientEntitlement[]
  embeddings       Embedding[]
  pendingActions   PendingAction[]

  // The desk — see the AI employee section at the foot of this file.
  employments       Employment[]
  employeeRuns      EmployeeRun[]
  escalations       Escalation[]
  connectorAccounts ConnectorAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductLine {
  id    String         @id @default(cuid())
  key   ProductLineKey @unique
  name  String
  blurb String

  plans Plan[]
}

model Plan {
  id            String         @id @default(cuid())
  key           String         @unique // launch, scale, command, monitor, operate, dominate
  name          String
  lineKey       ProductLineKey
  productLine   ProductLine    @relation(fields: [lineKey], references: [key])
  priceMonthly  Int // cents
  stripePriceId String?
  tagline       String
  features      String[]       @default([])

  // Metering limits (null = unlimited / not applicable)
  maxAgents           Int?
  maxAgentRunsMonthly Int?
  maxAdAccounts       Int?
  unlockedAgents      String[] @default([])

  subscriptions Subscription[]
}

model Subscription {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  lineKey ProductLineKey
  planKey String
  plan    Plan           @relation(fields: [planKey], references: [key])

  status               SubscriptionStatus @default(INCOMPLETE)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One subscription per line per client.
  @@unique([clientId, lineKey])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Agents
// ---------------------------------------------------------------------------

model AgentDefinition {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  persona          String
  tagline          String
  accent           String
  avatar           String
  baseSystemPrompt String  @db.Text
  emitsCrmPayload  Boolean @default(false)

  overrides     AgentPromptOverride[]
  conversations AgentConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentPromptOverride {
  id       String          @id @default(cuid())
  clientId String
  client   ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId  String
  agent    AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)

  systemPromptOverride String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, agentId])
}

model AgentConversation {
  id       String          @id @default(cuid())
  clientId String
  client   ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId  String
  agent    AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)

  title    String?
  messages AgentMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, agentId])
}

model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String      @db.Text
  /// Optional structured JSON payload (e.g. CRM record) attached to the message.
  payload Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
}

/// One row per completed agent run, used to meter against tier limits.
model UsageRecord {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  lineKey     ProductLineKey @default(AI_AGENTS)
  agentSlug   String
  /// Billing period bucket (start-of-month UTC) for fast metering queries.
  periodStart DateTime
  tokensIn    Int            @default(0)
  tokensOut   Int            @default(0)

  createdAt DateTime @default(now())

  @@index([clientId, periodStart])
}

// ---------------------------------------------------------------------------
// Ad operations
// ---------------------------------------------------------------------------

model AdAccount {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  platform   String // META, GOOGLE, TIKTOK, LINKEDIN…
  externalId String? // native account id, for a future API sync
  name       String
  currency   String  @default("USD")

  /// Targets the Spend Watch measures against. Null = that check is skipped
  /// rather than guessed — an alert fired against an invented target is worse
  /// than no alert.
  monthlyBudgetCents Int?
  targetCplCents     Int?
  targetCpaCents     Int?
  targetRoas         Float?

  metrics AdMetricDaily[]
  alerts  AdAlert[]

  createdAt DateTime @default(now())

  @@index([clientId])
}

/// Daily ad metrics. Ingestion-agnostic: manual entry / CSV now, API sync later
/// with no schema change (source records how the row arrived).
model AdMetricDaily {
  id          String    @id @default(cuid())
  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  date        DateTime
  spend       Int      @default(0) // cents
  impressions Int      @default(0)
  clicks      Int      @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  revenue     Int      @default(0) // cents
  source      String   @default("MANUAL") // MANUAL | CSV | API

  @@unique([adAccountId, date])
  @@index([adAccountId, date])
}

/// One finding from the Spend Watch. The unique constraint on
/// (adAccountId, kind, dateBucket) is what stops a daily sweep re-raising the
/// same problem every morning — an alert feed that cries wolf gets ignored,
/// and an ignored alert feed is worth less than none.
model AdAlert {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  kind     AdAlertKind
  severity AdAlertSeverity @default(WARNING)
  status   AdAlertStatus   @default(OPEN)

  title      String
  detail     String   @db.Text
  /// What the number was, and what it should have been.
  observed   Float?
  expected   Float?
  /// UTC day the finding belongs to.
  dateBucket DateTime

  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  @@unique([adAccountId, kind, dateBucket])
  @@index([clientId, status])
  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

model Request {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind   RequestKind   @default(OTHER)
  title  String
  body   String        @db.Text
  status RequestStatus @default(OPEN)

  comments RequestComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([status])
}

model RequestComment {
  id        String  @id @default(cuid())
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  authorId   String // User id
  authorName String
  authorRole Role
  body       String @db.Text

  createdAt DateTime @default(now())

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

/// One row per system module delivered to a client. Written automatically by
/// lib/provisioning.ts when a subscription activates; the unique constraint on
/// (clientId, moduleKey) is what makes repeated webhooks and tier upgrades safe.
model ProvisionedItem {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  planKey     String
  moduleKey   String
  kind        String // AGENT | PLAYBOOK | INTEGRATION | ASSET | MILESTONE
  name        String
  description String
  status      ProvisionStatus @default(READY)
  agentSlug   String?
  /// Starter prompt for playbooks, or the artifact body for assets.
  payload     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, moduleKey])
  @@index([clientId, kind])
}

// ---------------------------------------------------------------------------
// Inbound leads — the raw material the night shift works on
// ---------------------------------------------------------------------------

/// A lead delivered to the tenant's intake endpoint (or entered by hand).
/// Scored asynchronously by the night shift rather than on the request path,
/// so a slow model call can never make a client's form submission fail.
model Lead {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  source  String  @default("WEBHOOK") // WEBHOOK | MANUAL | CSV
  name    String?
  email   String?
  phone   String?
  company String?
  message String? @db.Text
  /// Whatever else the client's form posted, kept verbatim.
  raw     Json?

  status     LeadStatus @default(NEW)
  score      Int?
  tier       String? // HOT | WARM | COLD | DISQUALIFIED
  reasoning  String?    @db.Text
  nextAction String?    @db.Text
  scoredAt   DateTime?

  outcomes DealOutcome[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Night shift — unattended runs and the morning brief they produce
// ---------------------------------------------------------------------------

/// One brief per client per run date. The unique constraint is what makes the
/// cron safe to fire repeatedly (Vercel can and does retry).
model BriefRun {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  cadence BriefCadence @default(DAILY)
  /// UTC midnight bucket for the day this brief covers.
  runDate DateTime
  status  BriefStatus  @default(PENDING)

  leadsScored Int     @default(0)
  headline    String? @db.Text
  summary     String? @db.Text
  /// [{ title, detail, priority, leadId? }]
  sections    Json?
  error       String? @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([clientId, runDate])
  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// System memory — what the desk learns from real outcomes
// ---------------------------------------------------------------------------

/// A closed deal, won or lost. The qualification score is snapshotted here so
/// calibration stays correct even if the lead row is later edited or deleted.
model DealOutcome {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId   String?
  lead     Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  outcome    DealOutcomeKind
  valueCents Int             @default(0)

  scoreAtQualification Int?
  tierAtQualification  String?
  /// For losses: the objection that actually killed it.
  objection            String?
  source               String?
  notes                String? @db.Text

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

/// One learned fact about this tenant's business, derived from DealOutcome rows
/// by lib/memory.ts. Injected into every agent run, so the agents get more
/// accurate the longer a client stays. Clients can mute anything they disagree
/// with — the memory is theirs, not a black box.
model MemoryEntry {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind          String // CALIBRATION | OBJECTION | SOURCE | VALUE
  key           String
  content       String  @db.Text
  /// 0-1. Rises with evidence; entries below the floor are not injected.
  confidence    Float   @default(0)
  evidenceCount Int     @default(0)
  muted         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, kind, key])
  @@index([clientId])
}

/// A capacity add-on that has actually been granted to a client.
///
/// The Capacity add-ons (extra agent, run pack, extra ad account) are *sold* in
/// lib/addons.ts, but selling them changes nothing on its own — a row here is
/// what makes the meter move. Granted by an admin once the add-on request has
/// been scoped and billed, which is the same flow the rest of the add-ons use.
model ClientEntitlement {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// An add-on key from lib/addons.ts (capacity group).
  addonKey  String
  /// Stacks: two run packs = quantity 2.
  quantity  Int     @default(1)
  /// `extra-agent` must name which specialist it unlocks.
  agentSlug String?

  note      String?
  grantedBy String? // admin user id, for the audit trail
  grantedAt DateTime  @default(now())
  /// Null = open-ended. A past date is ignored by the resolver.
  expiresAt DateTime?

  @@index([clientId])
}

model WebhookConfig {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  label   String  @default("Primary CRM")
  url     String
  secret  String?
  enabled Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// The gate — nothing an automation proposes acts without passing through here
// ---------------------------------------------------------------------------

/// One action an automation wants to take on a client's behalf.
///
/// The upgrade catalogue publishes a promise for every automation build: that
/// anything moving money waits until a named human releases it, and that
/// nothing reaches a customer without being visible first. This table is that
/// promise. An automation does not send, invoice or charge — it proposes, and
/// the proposal sits here until it is released, pulled, or expires unfired.
///
/// `dedupeKey` is what makes an agent safe to re-run. A loop that wakes twice
/// on the same due job must not queue the same invoice twice, and the unique
/// constraint means it cannot, whatever the caller believes.
model PendingAction {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Which build proposed it — job-runner, comeback.
  build String
  /// Action kind key. Resolves through ACTION_KINDS in lib/gate.ts.
  kind  String

  hold  GateHold
  state GateState @default(HELD)

  /// Denormalised from the kind, so the queue can be filtered and audited
  /// without resolving every row through the registry.
  movesMoney Boolean @default(false)

  /// One line, so the queue is skimmable without opening anything.
  summary String
  /// Who or what this affects — a customer name, a job reference.
  subject String?
  /// The whole proposal, inspectable field by field.
  payload Json

  /// TIMED only: when it auto-releases if nobody pulls it first.
  releaseAt DateTime?
  /// Hard stop. Never fires after this, released or not.
  expiresAt DateTime

  releasedAt       DateTime?
  /// Recorded against a name — the published promise says "against your name".
  releasedBy       String?
  releasedByUserId String?
  /// True when the review window closed rather than a person clicking.
  autoReleased     Boolean   @default(false)

  withdrawnAt     DateTime?
  withdrawnBy     String?
  withdrawnReason String?   @db.Text

  executedAt DateTime?
  /// What actually happened, kept for the after-the-fact record.
  result     Json?
  error      String?   @db.Text

  /// Idempotency. A re-running agent must not double-propose.
  dedupeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, dedupeKey])
  @@index([clientId, state])
  @@index([clientId, createdAt])
  @@index([state, releaseAt])
  @@index([state, expiresAt])
}

// ---------------------------------------------------------------------------
// Retrieval — what the system remembers, and can find again
// ---------------------------------------------------------------------------

/// One embedded chunk of something a client owns.
///
/// WHY IT LIVES IN POSTGRES AND NOT A VECTOR SERVICE
///   Because the interesting queries are not "find similar text". They are
///   "find leads that read like this one, that belong to this client, that
///   actually closed, and tell me what they were worth" — which is a join. A
///   separate vector service turns that into a fan-out, a fetch by id, and a
///   filter in application code, and it puts the embedding in a system that
///   can drift out of step with the row it describes. Here the embedding is
///   written in the same transaction as the thing it embeds, backed up with
///   it, and deleted with it by the same cascade.
///
///   It also means one tenancy model. `clientId` is on the row and every query
///   filters on it, exactly like every other table in this schema — rather
///   than a namespace convention in another product that nobody's tests can
///   see.
///
/// `sourceType` + `sourceId` point back at the row this came from. Nothing
/// here is the source of truth; it is an index over rows that are.
model Embedding {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// LEAD | MEMORY | CONVERSATION | DOCUMENT
  sourceType String
  sourceId   String
  /// Which chunk of that source, 0-based. Short sources have exactly one.
  chunkIndex Int    @default(0)

  /// The text that was embedded, kept so a result can be shown and so a model
  /// change can re-embed without going back to the source.
  content String @db.Text
  /// Anything worth filtering or displaying without a join.
  meta    Json?

  /// Which model produced the vector. A mixed-model index returns nonsense
  /// distances, so every query filters on this and a re-embed writes a new one.
  model String
  /// pgvector. Dimension is pinned in lib/embeddings.ts and asserted there.
  embedding Unsupported("vector(1024)")?

  /// Postgres full-text, maintained alongside the vector so hybrid search does
  /// not need a second store either.
  tsv Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, sourceType, sourceId, chunkIndex, model])
  @@index([clientId, sourceType])
  @@index([clientId, model])
}

// ---------------------------------------------------------------------------
// The desk — AI employees, their shifts, and everything they did
//
// `agents.ts` is five prompts a person opens. This is the other arrangement: a
// role with a shift, tools, a written ceiling on what it may commit, and a row
// for every single thing it did. The four tables below are the accountability
// half of that — an employee whose work cannot be read afterwards is not an
// employee, it is an unattended script with a personality.
// ---------------------------------------------------------------------------

/// One employee, hired by one client.
///
/// A row here is what makes an employee real for a tenant. The roster in
/// lib/employees.ts is a definition; this is the employment. Written by an
/// admin once the build the employee staffs has been scoped and billed — the
/// same flow the capacity add-ons use — so an employee can never start working
/// for a business that has not bought the build it belongs to.
model Employment {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Resolves through EMPLOYEES in lib/employees.ts.
  employeeSlug String
  state        EmploymentState @default(TRIAL)

  /// Overrides the roster default when a client wants a tighter or looser
  /// ceiling. Null means "use what the roster says".
  moneyCeilingCents Int?

  /// Who did the hiring, for the audit trail.
  hiredBy String?
  hiredAt DateTime @default(now())
  note    String?  @db.Text

  runs        EmployeeRun[]
  updatedAt   DateTime      @updatedAt

  @@unique([clientId, employeeSlug])
  @@index([clientId, state])
}

/// One duty, run once.
///
/// `runKey` is the shift's idempotency. It buckets a run by duty and by the
/// interval the duty is scheduled on, so a cron that fires twice — and Vercel
/// does retry — cannot produce two runs of the same shift, and therefore cannot
/// double-propose everything that shift proposes.
model EmployeeRun {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  employmentId String?
  employment   Employment? @relation(fields: [employmentId], references: [id], onDelete: SetNull)

  employeeSlug String
  dutyKey      String
  /// SHIFT | SIGNAL | ASKED
  trigger      String            @default("SHIFT")
  status       EmployeeRunStatus @default(RUNNING)

  /// How many model turns it took, including repairs after a bad reply.
  attempts Int @default(1)

  /// From the duty report.
  reviewed   Int?
  summary    String? @db.Text
  confidence Float?

  /// How many proposals actually reached the gate. Distinct from what the
  /// employee claims in its summary, and the number worth trusting.
  proposed Int @default(0)

  /// What the context budget did. `contextDropped` is why an investigation can
  /// tell "it saw the job and judged badly" from "it never saw the job".
  contextTokens  Int?
  contextDropped Json?

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  error String? @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  toolCalls   EmployeeToolCall[]
  escalations Escalation[]

  /// employeeSlug:dutyKey:bucket — one run per duty per scheduled interval.
  runKey String

  @@unique([clientId, runKey])
  @@index([clientId, employeeSlug, startedAt])
  @@index([clientId, status])
}

/// One tool call an employee made.
///
/// Reads are recorded as well as writes, and that is not padding. "Why did it
/// not chase that invoice?" is usually answered by the reads: it never looked,
/// or it looked and the record said something else. A log of writes alone shows
/// what happened and never why.
model EmployeeToolCall {
  id    String      @id @default(cuid())
  runId String
  run   EmployeeRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  clientId String

  /// Resolves through OPERATIONS in lib/connectors.ts.
  operationKey String
  /// READ | WRITE
  direction    String

  /// OK | REFUSED | ESCALATED | FAILED | UNAVAILABLE
  status String

  input  Json
  result Json?
  error  String? @db.Text

  /// WRITE calls that were accepted: the queue row this became. A write with
  /// no pending action here either never reached the gate or was refused, and
  /// which one is in `status`.
  pendingActionId String?

  tookMs    Int?
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([clientId, createdAt])
}

/// A question an employee stopped to ask a person.
///
/// Deliberately its own table rather than a flag on the run. An escalation
/// outlives the run that raised it — it is open until somebody answers it —
/// and it is the one thing in this system that is *waiting on a human* rather
/// than the other way round, which is exactly what a console needs to surface.
model Escalation {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  runId String?
  run   EmployeeRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  employeeSlug String
  dutyKey      String

  /// LOW_CONFIDENCE | OVER_CEILING | NO_AUTHORITY | INVALID_OUTPUT |
  /// MODEL_ERROR | TOOL_ERROR | ASKED
  reason String

  title    String
  body     String @db.Text
  /// The specific thing a person has to decide.
  question String @db.Text

  state      EscalationState @default(OPEN)
  answer     String?         @db.Text
  answeredBy String?
  answeredAt DateTime?

  createdAt DateTime @default(now())

  @@index([clientId, state, createdAt])
}

/// A connector one client has actually wired up.
///
/// WHAT IS NOT HERE
///   Secrets. `config` holds the parts that are not sensitive — an endpoint
///   URL, a calendar id, a from-address — and `secretRef` names where the
///   credential lives (an environment variable, or a key in whatever secret
///   store is in front of this deployment). Nothing in this database is a
///   token.
///
///   That is a deliberate limitation rather than a gap to fill later. A row in
///   an application database is readable by every query in the application,
///   appears in backups nobody encrypts separately, and shows up in the logs of
///   the first person who debugs a Prisma query with `include`. A connector
///   table holding live CRM tokens for every tenant is the highest-value target
///   in the product, and it is not worth building for the convenience of a
///   settings screen.
model ConnectorAccount {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Resolves through CONNECTORS in lib/connectors.ts.
  connectorKey String
  label        String  @default("Primary")
  enabled      Boolean @default(true)

  /// Non-sensitive fields only.
  config Json?
  /// The name of the secret, never the secret.
  secretRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, connectorKey])
  @@index([clientId])
}
