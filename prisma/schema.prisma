// PHX Growth Plus — data model.
// Feature gating uses Subscription rows as the source of truth (kept in sync by
// the Stripe webhook handler). Every client-owned row carries clientId for
// multi-tenant scoping (see src/lib/tenancy.ts).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector, declared so `db push` installs it rather than failing on a
  // column type the database has never heard of.
  extensions = [vector]
}

enum Role {
  CLIENT
  ADMIN
}

enum ProductLineKey {
  AI_AGENTS
  AD_OPS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  DELIVERED
}

enum RequestKind {
  NEW_CREATIVE
  CAMPAIGN_CHANGE
  STRATEGY_QUESTION
  OTHER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

/// READY = live now; SCHEDULED = human build work; IN_PROGRESS = being delivered.
enum ProvisionStatus {
  READY
  SCHEDULED
  IN_PROGRESS
}

/// Lifecycle of an inbound lead, from webhook to closed deal.
enum LeadStatus {
  NEW
  SCORED
  WORKING
  WON
  LOST
}

/// How often the night shift produces a brief for a client. Tier-gated.
enum BriefCadence {
  DAILY
  WEEKLY
}

enum BriefStatus {
  PENDING
  COMPLETE
  FAILED
}

enum DealOutcomeKind {
  WON
  LOST
}

/// What the Spend Watch found. One value per check in lib/spend-watch.ts.
enum AdAlertKind {
  PACING_OVER
  PACING_UNDER
  CPL_DRIFT
  DELIVERY_GAP
  CREATIVE_FATIGUE
  CPA_BREACH
  ROAS_DECLINE
  ANOMALY
}

enum AdAlertSeverity {
  CRITICAL
  WARNING
  INFO
}

/// How an automation's proposal is held before it can act.
enum GateHold {
  /// Never fires without a named human releasing it. Anything that moves money.
  MANUAL
  /// Visible before it goes; auto-releases when the review window closes.
  TIMED
}

enum GateState {
  HELD
  RELEASED
  EXECUTED
  /// A human pulled it out of the queue.
  WITHDRAWN
  /// Nobody released it in time. Never fires.
  EXPIRED
  FAILED
}

enum AdAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

/// Where a finished call ended up. Mirrors CallOutcome in lib/voice.ts, which
/// derives it from the call's state — the column is the record, not the rule.
enum VoiceCallOutcome {
  BOOKED
  QUOTED
  QUALIFIED
  HANDED_OFF
  MESSAGE_TAKEN
  OUT_OF_AREA
  NOT_A_FIT
  OPTED_OUT
  ABANDONED
  FAILED
}

enum EstimateStatus {
  /// Priced, and spoken on the call. Not yet a document anybody has.
  DRAFT
  /// Queued at the gate, waiting for a named human to release it.
  QUEUED
  SENT
  ACCEPTED
  DECLINED
}

enum TuneStatus {
  PENDING
  APPLIED
  REJECTED
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) core models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CLIENT)

  accounts Account[]
  sessions Session[]

  // A CLIENT user owns exactly one ClientProfile (their tenant).
  clientProfile ClientProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Tenant + subscription domain
// ---------------------------------------------------------------------------

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName String
  industry     String?
  website      String?
  adPlatforms  String[]  @default([])
  goals        String?
  voiceTone    String? // saved brand voice used by agents
  onboardedAt  DateTime?

  /// Industry pack (see lib/verticals.ts). Pre-tunes the rubric, escalation
  /// matrix, voice profile and playbook prompts at provisioning time.
  verticalKey String?

  // --- Intake. Captured at onboarding; these are the answers the build phase
  // --- would otherwise extract on a call, repeated for every single client.
  serviceArea        String?
  offerSummary       String?   @db.Text
  priceRange         String?
  differentiator     String?   @db.Text
  proofPoints        String?   @db.Text
  /// Targets, in cents. Copied onto the client's ad accounts so the Spend Watch
  /// checks that depend on them stop being skipped.
  monthlyBudgetCents Int?
  targetCplCents     Int?
  targetCpaCents     Int?
  targetRoas         Float?
  crmPlatform        String?
  leadDestination    String?
  approverName       String?
  approverEmail      String?
  wordsWeUse         String?
  wordsWeAvoid       String?
  /// Anything the structured columns don't cover, kept verbatim.
  intakeAnswers      Json?
  /// Set when the client finishes the intake, as distinct from onboardedAt
  /// which only means they saw the first screen.
  intakeCompletedAt  DateTime?

  /// Secret for this tenant's public lead-intake endpoint. Rotatable.
  intakeToken String? @unique

  /// Night shift: the unattended run that produces the morning brief.
  nightShiftEnabled   Boolean   @default(true)
  /// UTC hour (0-23) the brief should be waiting by. Default 13:00 UTC = 6am Phoenix.
  briefHourUtc        Int       @default(13)
  /// Last completed Spend Watch sweep. Gates the hourly cron to one sweep a day
  /// even when a sweep finds nothing and so writes no alert rows.
  spendWatchLastRunAt DateTime?

  stripeCustomerId String? @unique

  subscriptions    Subscription[]
  conversations    AgentConversation[]
  usageRecords     UsageRecord[]
  adAccounts       AdAccount[]
  requests         Request[]
  webhookConfigs   WebhookConfig[]
  agentOverrides   AgentPromptOverride[]
  provisionedItems ProvisionedItem[]
  leads            Lead[]
  briefRuns        BriefRun[]
  dealOutcomes     DealOutcome[]
  memoryEntries    MemoryEntry[]
  adAlerts         AdAlert[]
  entitlements     ClientEntitlement[]
  embeddings       Embedding[]
  pendingActions   PendingAction[]
  playbooks        VoicePlaybook[]
  priceBooks       VoicePriceBook[]
  calls            VoiceCall[]
  estimates        VoiceEstimate[]
  tuneProposals    TuneProposal[]
  doNotCall        DoNotCallEntry[]
  bookingCalendar  BookingCalendar?
  appointments     Appointment[]
  connections      Connection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductLine {
  id    String         @id @default(cuid())
  key   ProductLineKey @unique
  name  String
  blurb String

  plans Plan[]
}

model Plan {
  id            String         @id @default(cuid())
  key           String         @unique // launch, scale, command, monitor, operate, dominate
  name          String
  lineKey       ProductLineKey
  productLine   ProductLine    @relation(fields: [lineKey], references: [key])
  priceMonthly  Int // cents
  stripePriceId String?
  tagline       String
  features      String[]       @default([])

  // Metering limits (null = unlimited / not applicable)
  maxAgents           Int?
  maxAgentRunsMonthly Int?
  maxAdAccounts       Int?
  unlockedAgents      String[] @default([])

  subscriptions Subscription[]
}

model Subscription {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  lineKey ProductLineKey
  planKey String
  plan    Plan           @relation(fields: [planKey], references: [key])

  status               SubscriptionStatus @default(INCOMPLETE)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One subscription per line per client.
  @@unique([clientId, lineKey])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Agents
// ---------------------------------------------------------------------------

model AgentDefinition {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  persona          String
  tagline          String
  accent           String
  avatar           String
  baseSystemPrompt String  @db.Text
  emitsCrmPayload  Boolean @default(false)

  overrides     AgentPromptOverride[]
  conversations AgentConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentPromptOverride {
  id       String          @id @default(cuid())
  clientId String
  client   ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId  String
  agent    AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)

  systemPromptOverride String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, agentId])
}

model AgentConversation {
  id       String          @id @default(cuid())
  clientId String
  client   ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId  String
  agent    AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)

  title    String?
  messages AgentMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, agentId])
}

model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String      @db.Text
  /// Optional structured JSON payload (e.g. CRM record) attached to the message.
  payload Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
}

/// One row per completed agent run, used to meter against tier limits.
model UsageRecord {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  lineKey     ProductLineKey @default(AI_AGENTS)
  agentSlug   String
  /// Billing period bucket (start-of-month UTC) for fast metering queries.
  periodStart DateTime
  tokensIn    Int            @default(0)
  tokensOut   Int            @default(0)

  createdAt DateTime @default(now())

  @@index([clientId, periodStart])
}

// ---------------------------------------------------------------------------
// Ad operations
// ---------------------------------------------------------------------------

model AdAccount {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  platform   String // META, GOOGLE, TIKTOK, LINKEDIN…
  externalId String? // native account id, for a future API sync
  name       String
  currency   String  @default("USD")

  /// Targets the Spend Watch measures against. Null = that check is skipped
  /// rather than guessed — an alert fired against an invented target is worse
  /// than no alert.
  monthlyBudgetCents Int?
  targetCplCents     Int?
  targetCpaCents     Int?
  targetRoas         Float?

  metrics AdMetricDaily[]
  alerts  AdAlert[]

  createdAt DateTime @default(now())

  @@index([clientId])
}

/// Daily ad metrics. Ingestion-agnostic: manual entry / CSV now, API sync later
/// with no schema change (source records how the row arrived).
model AdMetricDaily {
  id          String    @id @default(cuid())
  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  date        DateTime
  spend       Int      @default(0) // cents
  impressions Int      @default(0)
  clicks      Int      @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  revenue     Int      @default(0) // cents
  source      String   @default("MANUAL") // MANUAL | CSV | API

  @@unique([adAccountId, date])
  @@index([adAccountId, date])
}

/// One finding from the Spend Watch. The unique constraint on
/// (adAccountId, kind, dateBucket) is what stops a daily sweep re-raising the
/// same problem every morning — an alert feed that cries wolf gets ignored,
/// and an ignored alert feed is worth less than none.
model AdAlert {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  kind     AdAlertKind
  severity AdAlertSeverity @default(WARNING)
  status   AdAlertStatus   @default(OPEN)

  title      String
  detail     String   @db.Text
  /// What the number was, and what it should have been.
  observed   Float?
  expected   Float?
  /// UTC day the finding belongs to.
  dateBucket DateTime

  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  @@unique([adAccountId, kind, dateBucket])
  @@index([clientId, status])
  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

model Request {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind   RequestKind   @default(OTHER)
  title  String
  body   String        @db.Text
  status RequestStatus @default(OPEN)

  comments RequestComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([status])
}

model RequestComment {
  id        String  @id @default(cuid())
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  authorId   String // User id
  authorName String
  authorRole Role
  body       String @db.Text

  createdAt DateTime @default(now())

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

/// One row per system module delivered to a client. Written automatically by
/// lib/provisioning.ts when a subscription activates; the unique constraint on
/// (clientId, moduleKey) is what makes repeated webhooks and tier upgrades safe.
model ProvisionedItem {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  planKey     String
  moduleKey   String
  kind        String // AGENT | PLAYBOOK | INTEGRATION | ASSET | MILESTONE
  name        String
  description String
  status      ProvisionStatus @default(READY)
  agentSlug   String?
  /// Starter prompt for playbooks, or the artifact body for assets.
  payload     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, moduleKey])
  @@index([clientId, kind])
}

// ---------------------------------------------------------------------------
// Inbound leads — the raw material the night shift works on
// ---------------------------------------------------------------------------

/// A lead delivered to the tenant's intake endpoint (or entered by hand).
/// Scored asynchronously by the night shift rather than on the request path,
/// so a slow model call can never make a client's form submission fail.
model Lead {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  source  String  @default("WEBHOOK") // WEBHOOK | MANUAL | CSV
  name    String?
  email   String?
  phone   String?
  company String?
  message String? @db.Text
  /// Whatever else the client's form posted, kept verbatim.
  raw     Json?

  status     LeadStatus @default(NEW)
  score      Int?
  tier       String? // HOT | WARM | COLD | DISQUALIFIED
  reasoning  String?    @db.Text
  nextAction String?    @db.Text
  scoredAt   DateTime?

  outcomes DealOutcome[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Night shift — unattended runs and the morning brief they produce
// ---------------------------------------------------------------------------

/// One brief per client per run date. The unique constraint is what makes the
/// cron safe to fire repeatedly (Vercel can and does retry).
model BriefRun {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  cadence BriefCadence @default(DAILY)
  /// UTC midnight bucket for the day this brief covers.
  runDate DateTime
  status  BriefStatus  @default(PENDING)

  leadsScored Int     @default(0)
  headline    String? @db.Text
  summary     String? @db.Text
  /// [{ title, detail, priority, leadId? }]
  sections    Json?
  error       String? @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([clientId, runDate])
  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// System memory — what the desk learns from real outcomes
// ---------------------------------------------------------------------------

/// A closed deal, won or lost. The qualification score is snapshotted here so
/// calibration stays correct even if the lead row is later edited or deleted.
model DealOutcome {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId   String?
  lead     Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  outcome    DealOutcomeKind
  valueCents Int             @default(0)

  scoreAtQualification Int?
  tierAtQualification  String?
  /// For losses: the objection that actually killed it.
  objection            String?
  source               String?
  notes                String? @db.Text

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

/// One learned fact about this tenant's business, derived from DealOutcome rows
/// by lib/memory.ts. Injected into every agent run, so the agents get more
/// accurate the longer a client stays. Clients can mute anything they disagree
/// with — the memory is theirs, not a black box.
model MemoryEntry {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind          String // CALIBRATION | OBJECTION | SOURCE | VALUE
  key           String
  content       String  @db.Text
  /// 0-1. Rises with evidence; entries below the floor are not injected.
  confidence    Float   @default(0)
  evidenceCount Int     @default(0)
  muted         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, kind, key])
  @@index([clientId])
}

/// A capacity add-on that has actually been granted to a client.
///
/// The Capacity add-ons (extra agent, run pack, extra ad account) are *sold* in
/// lib/addons.ts, but selling them changes nothing on its own — a row here is
/// what makes the meter move. Granted by an admin once the add-on request has
/// been scoped and billed, which is the same flow the rest of the add-ons use.
model ClientEntitlement {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// An add-on key from lib/addons.ts (capacity group).
  addonKey  String
  /// Stacks: two run packs = quantity 2.
  quantity  Int     @default(1)
  /// `extra-agent` must name which specialist it unlocks.
  agentSlug String?

  note      String?
  grantedBy String? // admin user id, for the audit trail
  grantedAt DateTime  @default(now())
  /// Null = open-ended. A past date is ignored by the resolver.
  expiresAt DateTime?

  @@index([clientId])
}

model WebhookConfig {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  label   String  @default("Primary CRM")
  url     String
  secret  String?
  enabled Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// The gate — nothing an automation proposes acts without passing through here
// ---------------------------------------------------------------------------

/// One action an automation wants to take on a client's behalf.
///
/// The upgrade catalogue publishes a promise for every automation build: that
/// anything moving money waits until a named human releases it, and that
/// nothing reaches a customer without being visible first. This table is that
/// promise. An automation does not send, invoice or charge — it proposes, and
/// the proposal sits here until it is released, pulled, or expires unfired.
///
/// `dedupeKey` is what makes an agent safe to re-run. A loop that wakes twice
/// on the same due job must not queue the same invoice twice, and the unique
/// constraint means it cannot, whatever the caller believes.
model PendingAction {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Which build proposed it — job-runner, comeback.
  build String
  /// Action kind key. Resolves through ACTION_KINDS in lib/gate.ts.
  kind  String

  hold  GateHold
  state GateState @default(HELD)

  /// Denormalised from the kind, so the queue can be filtered and audited
  /// without resolving every row through the registry.
  movesMoney Boolean @default(false)

  /// One line, so the queue is skimmable without opening anything.
  summary String
  /// Who or what this affects — a customer name, a job reference.
  subject String?
  /// The whole proposal, inspectable field by field.
  payload Json

  /// TIMED only: when it auto-releases if nobody pulls it first.
  releaseAt DateTime?
  /// Hard stop. Never fires after this, released or not.
  expiresAt DateTime

  releasedAt       DateTime?
  /// Recorded against a name — the published promise says "against your name".
  releasedBy       String?
  releasedByUserId String?
  /// True when the review window closed rather than a person clicking.
  autoReleased     Boolean   @default(false)

  withdrawnAt     DateTime?
  withdrawnBy     String?
  withdrawnReason String?   @db.Text

  executedAt DateTime?
  /// What actually happened, kept for the after-the-fact record.
  result     Json?
  error      String?   @db.Text

  /// Idempotency. A re-running agent must not double-propose.
  dedupeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, dedupeKey])
  @@index([clientId, state])
  @@index([clientId, createdAt])
  @@index([state, releaseAt])
  @@index([state, expiresAt])
}

// ---------------------------------------------------------------------------
// Retrieval — what the system remembers, and can find again
// ---------------------------------------------------------------------------

/// One embedded chunk of something a client owns.
///
/// WHY IT LIVES IN POSTGRES AND NOT A VECTOR SERVICE
///   Because the interesting queries are not "find similar text". They are
///   "find leads that read like this one, that belong to this client, that
///   actually closed, and tell me what they were worth" — which is a join. A
///   separate vector service turns that into a fan-out, a fetch by id, and a
///   filter in application code, and it puts the embedding in a system that
///   can drift out of step with the row it describes. Here the embedding is
///   written in the same transaction as the thing it embeds, backed up with
///   it, and deleted with it by the same cascade.
///
///   It also means one tenancy model. `clientId` is on the row and every query
///   filters on it, exactly like every other table in this schema — rather
///   than a namespace convention in another product that nobody's tests can
///   see.
///
/// `sourceType` + `sourceId` point back at the row this came from. Nothing
/// here is the source of truth; it is an index over rows that are.
model Embedding {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// LEAD | MEMORY | CONVERSATION | DOCUMENT
  sourceType String
  sourceId   String
  /// Which chunk of that source, 0-based. Short sources have exactly one.
  chunkIndex Int    @default(0)

  /// The text that was embedded, kept so a result can be shown and so a model
  /// change can re-embed without going back to the source.
  content String @db.Text
  /// Anything worth filtering or displaying without a join.
  meta    Json?

  /// Which model produced the vector. A mixed-model index returns nonsense
  /// distances, so every query filters on this and a re-embed writes a new one.
  model String
  /// pgvector. Dimension is pinned in lib/embeddings.ts and asserted there.
  embedding Unsupported("vector(1024)")?

  /// Postgres full-text, maintained alongside the vector so hybrid search does
  /// not need a second store either.
  tsv Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, sourceType, sourceId, chunkIndex, model])
  @@index([clientId, sourceType])
  @@index([clientId, model])
}

// ---------------------------------------------------------------------------
// The Voice Employee — the operator that answers the phone, and its training
// ---------------------------------------------------------------------------

/// One version of a client's call playbook.
///
/// VERSIONED, NEVER UPDATED IN PLACE
///   The Tuning Lab's promise is a written record of what changed and what it
///   moved, and that is impossible against a row that gets overwritten. Every
///   approved retune writes a new version and flips `active`; every call records
///   the version it ran under. That is what makes "month two is measurably
///   better than month one" a claim anybody can check rather than a feeling.
///
/// The playbook itself is JSON, validated by `playbookSchema` in lib/voice.ts
/// rather than by columns. Its shape changes as the Lab learns what a trade
/// needs to say, and a migration per field would mean the shape stops changing.
model VoicePlaybook {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  version Int
  active  Boolean @default(false)

  /// Validated by playbookSchema. Never read raw.
  payload Json

  /// Why this version exists. Written by the Lab or typed by the owner.
  note      String? @db.Text
  createdBy String?

  createdAt DateTime @default(now())

  @@unique([clientId, version])
  @@index([clientId, active])
}

/// One version of a client's price book — the only place a spoken number can
/// come from. Versioned for the same reason as the playbook: a price that
/// changed silently makes every earlier estimate unexplainable.
model VoicePriceBook {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  version Int
  active  Boolean @default(false)

  /// Validated by priceBookSchema in lib/estimates.ts.
  payload Json

  note      String? @db.Text
  createdBy String?

  createdAt DateTime @default(now())

  @@unique([clientId, version])
  @@index([clientId, active])
}

/// One call, inbound or outbound.
///
/// `turns` is stored redacted. `redactSpoken` runs before the write, not on the
/// way out to a screen, because a card number that reaches this table has
/// already been backed up, embedded for retrieval and mailed in a brief.
model VoiceCall {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// The telephony provider's id. Unique so a retried webhook cannot fork a
  /// call into two records.
  providerCallId String? @unique
  provider       String?

  direction CallDirection
  /// One of CALL_PURPOSES in lib/voice.ts.
  purpose   String

  fromNumber String?
  toNumber   String?

  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?

  outcome VoiceCallOutcome?

  /// Slots the call filled. Keyed by qualifier slot.
  captured Json?
  /// Turn[] — role, text, at. Redacted.
  turns    Json?

  /// Which playbook was in force. Makes a grade attributable to a version.
  playbookVersion  Int?
  priceBookVersion Int?

  handoffReason String? @db.Text
  recordingUrl  String?

  /// Cents, when this call quoted. Graded against the spoken cap.
  quotedTotalCents Int?

  /// The missed-call text-back. Set once, so a retried webhook cannot send a
  /// second one to somebody who already got it.
  textBackSentAt DateTime?
  textBackStatus String?

  // --- The Tuning Lab's read of this call.
  gradeScore    Int?
  gradeClean    Boolean?
  gradeHeadline String?  @db.Text
  /// Finding[] from lib/training.ts.
  gradeFindings Json?
  gradedAt      DateTime?

  /// Work the caller asked for that the price book could not price.
  unpricedItems        String[] @default([])
  /// Questions that forced a handover, as the caller asked them.
  unansweredQuestions  String[] @default([])

  /// What the deal did, once it is known. Set from the CRM or by hand — this is
  /// what "graded against what the deal actually did" reads.
  dealOutcome    DealOutcomeKind?
  dealValueCents Int?

  estimates    VoiceEstimate[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, startedAt])
  @@index([clientId, outcome])
  @@index([clientId, gradedAt])
}

/// A priced job. The spoken version lives in `spoken`; the document does not
/// leave without a PendingAction releasing it.
model VoiceEstimate {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  callId String?
  call   VoiceCall? @relation(fields: [callId], references: [id], onDelete: SetNull)

  customerName    String?
  customerPhone   String?
  customerAddress String?
  jobDescription  String? @db.Text

  /// The full breakdown — quotePayload() in lib/estimates.ts.
  payload Json

  totalCents Int
  lowCents   Int
  highCents  Int
  /// HIGH | MEDIUM | LOW, with the sentence that explains it.
  confidence String
  /// Exactly what was said out loud, kept verbatim. If a customer says "you
  /// told me eleven hundred", this is the answer.
  spoken     String? @db.Text

  status EstimateStatus @default(DRAFT)

  /// The gate row holding the document. Null until it is proposed.
  pendingActionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([clientId, createdAt])
}

/// A change the Tuning Lab wants to make, waiting on the owner.
///
/// Same posture as the gate: the system notices, recommends, and does not act.
/// `key` is unique per client so a proposal the owner rejected last month is not
/// offered again the moment the same three calls come round.
model TuneProposal {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Stable identity of this suggestion. From proposeRetunes().
  key    String
  /// playbook | pricebook
  target String

  title String
  why   String @db.Text

  /// VoiceCall ids this came from.
  evidence String[] @default([])

  /// A Patch from lib/training.ts. Applied by applyPatch, never by hand.
  patch Json

  status TuneStatus @default(PENDING)

  /// Owner-supplied text for patches that need it — an answer to teach, a rate.
  filledValue String? @db.Text

  decidedBy String?
  decidedAt DateTime?
  /// The playbook or price book version this produced.
  resultVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, key])
  @@index([clientId, status])
}

/// Numbers that must never be dialled again.
///
/// A row here beats consent, a campaign, a schedule and anything an agent
/// believes. `canCallNow` checks it first for that reason.
model DoNotCallEntry {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  phone  String
  /// Where it came from — a call, an SMS reply, the owner.
  source String?
  reason String? @db.Text
  /// The call it was said on, for the record.
  callId String?

  createdAt DateTime @default(now())

  @@unique([clientId, phone])
  @@index([clientId, createdAt])
}

/// A client's booking rules. One per tenant, versionless — unlike the playbook
/// this is operational state rather than a claim the Tuning Lab argues about,
/// and an owner changing their working hours does not want a version history.
model BookingCalendar {
  id       String        @id @default(cuid())
  clientId String        @unique
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Validated by calendarSchema in lib/booking.ts.
  payload Json

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A visit the operator booked on a call.
///
/// `slotKey` is the minute-precision key the operator read out loud, and it is
/// unique per client: two calls landing on the same slot at the same moment
/// cannot both book it, whatever either conversation believed.
model Appointment {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  callId String?
  call   VoiceCall? @relation(fields: [callId], references: [id], onDelete: SetNull)

  slotKey String
  at      DateTime
  minutes Int    @default(60)

  customerName    String?
  customerPhone   String?
  customerAddress String?
  jobDescription  String? @db.Text

  /// BOOKED | CANCELLED | COMPLETED | NO_SHOW
  status String @default("BOOKED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, slotKey])
  @@index([clientId, at])
}

// ---------------------------------------------------------------------------
// Connections — how the rest of a client's software finds out what happened
// ---------------------------------------------------------------------------

/// One destination a client has connected.
///
/// Two shapes live in this table. A URL destination (webhook, Zapier, Make,
/// n8n) stores `url` plus a generated `secret` used to sign every request. An
/// adapter destination (QuickBooks) stores `credentials` instead. Neither the
/// secret nor the credentials are ever rendered back onto a screen; the secret
/// is shown exactly once, at the moment it is created.
model Connection {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// A ConnectorId from lib/connectors.ts.
  connector String
  label     String
  enabled   Boolean @default(true)

  /// Event types this destination wants. Empty means everything the connector
  /// accepts — see wantsEvent(); silence is a worse default than noise.
  events String[] @default([])

  url    String?
  secret String?

  /// Adapter configuration — refresh token, realm id, environment. Secret.
  credentials Json?

  lastOkAt            DateTime?
  lastFailAt          DateTime?
  lastError           String?   @db.Text
  consecutiveFailures Int       @default(0)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries EventDelivery[]

  @@index([clientId, enabled])
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DROPPED
}

/// The outbox. One row per (connection, event).
///
/// The unique constraint is the whole idempotency story: the same real-world
/// occurrence always produces the same `eventId` (see buildEvent), so emitting
/// twice — and a provider webhook retry will — cannot deliver twice.
model EventDelivery {
  id       String @id @default(cuid())
  clientId String

  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  eventId   String
  eventType String
  /// The full envelope as it will be sent, already scrubbed.
  payload   Json

  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime?
  lastStatus    Int?
  lastError     String?        @db.Text
  deliveredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([clientId, createdAt])
}
